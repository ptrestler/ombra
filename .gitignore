# derived - rebuild with `make`
build/

# dist/ was briefly committed so the page could just be downloaded. It is 5.3 MB
# of base64 over gzip, so it barely compresses and git cannot delta it: every
# rebuild added that much to the history for good. CI publishes it as a release
# asset instead, which lives outside the history and is always the newest build.
dist/

# The cached OSM and elevation downloads ARE committed, on purpose: a cold fetch
# takes about an hour against public Overpass mirrors, and a failing mirror
# returns zero elements rather than an error. See CLAUDE.md.

node_modules/
__pycache__/
*.pyc

# Claude Code's local permission settings: machine-specific absolute paths,
# not project source.
.claude/
